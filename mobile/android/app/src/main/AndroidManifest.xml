<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- App Links: these www.polarlights.io pages open in the app (verified by /.well-known/assetlinks.json).
                 The home page (alert emails), map, Sky, Alerts and gallery (shared photos) only: sign-in,
                 checkout, dashboard and password reset stay in the browser where those flows began. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <!-- www only: polarlights.io redirects there, and Android won't follow a redirect to
                     assetlinks.json, so listing it would fail verification (on Android 11 and older, for both). -->
                <data android:host="www.polarlights.io" />
                <data android:path="/" />
                <data android:path="/en" />
                <data android:path="/es" />
                <data android:path="/fr" />
                <data android:path="/de" />
                <data android:path="/nl" />
                <data android:path="/nb" />
                <data android:path="/da" />
                <data android:path="/sv" />
                <data android:path="/fi" />
                <data android:path="/ru" />
                <data android:pathPrefix="/gallery" />
                <data android:pathPrefix="/map" />
                <data android:pathPrefix="/sky" />
                <data android:pathPrefix="/alerts" />
                <data android:pathPrefix="/en/gallery" />
                <data android:pathPrefix="/en/map" />
                <data android:pathPrefix="/en/sky" />
                <data android:pathPrefix="/en/alerts" />
                <data android:pathPrefix="/es/gallery" />
                <data android:pathPrefix="/es/map" />
                <data android:pathPrefix="/es/sky" />
                <data android:pathPrefix="/es/alerts" />
                <data android:pathPrefix="/fr/gallery" />
                <data android:pathPrefix="/fr/map" />
                <data android:pathPrefix="/fr/sky" />
                <data android:pathPrefix="/fr/alerts" />
                <data android:pathPrefix="/de/gallery" />
                <data android:pathPrefix="/de/map" />
                <data android:pathPrefix="/de/sky" />
                <data android:pathPrefix="/de/alerts" />
                <data android:pathPrefix="/nl/gallery" />
                <data android:pathPrefix="/nl/map" />
                <data android:pathPrefix="/nl/sky" />
                <data android:pathPrefix="/nl/alerts" />
                <data android:pathPrefix="/nb/gallery" />
                <data android:pathPrefix="/nb/map" />
                <data android:pathPrefix="/nb/sky" />
                <data android:pathPrefix="/nb/alerts" />
                <data android:pathPrefix="/da/gallery" />
                <data android:pathPrefix="/da/map" />
                <data android:pathPrefix="/da/sky" />
                <data android:pathPrefix="/da/alerts" />
                <data android:pathPrefix="/sv/gallery" />
                <data android:pathPrefix="/sv/map" />
                <data android:pathPrefix="/sv/sky" />
                <data android:pathPrefix="/sv/alerts" />
                <data android:pathPrefix="/fi/gallery" />
                <data android:pathPrefix="/fi/map" />
                <data android:pathPrefix="/fi/sky" />
                <data android:pathPrefix="/fi/alerts" />
                <data android:pathPrefix="/ru/gallery" />
                <data android:pathPrefix="/ru/map" />
                <data android:pathPrefix="/ru/sky" />
                <data android:pathPrefix="/ru/alerts" />
            </intent-filter>
        </activity>

        <!-- Push alerts (Firebase): the status bar icon and accent colour. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_aurora" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_accent" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="aurora" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Your sky: where you are, for the forecast and alerts. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Alerts: Android 13+ asks before an app may show notifications. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Gallery: saving to the Polar Lights album needs this only on Android 9 and older. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <!-- The app still installs on devices without GPS; Your sky then uses network location or a searched place. -->
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
</manifest>
